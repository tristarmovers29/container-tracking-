
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  background: #f4f7fb;
  color: #172033;
}

.header {
  background: #102a43;
  color: white;
  padding: 18px 6%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
}

.logo {
  font-size: 22px;
  font-weight: 800;
}

.badge {
  font-size: 12px;
  background: #1f4f73;
  padding: 8px 12px;
  border-radius: 20px;
}

.hero {
  background: linear-gradient(135deg, #12344d, #176b87);
  color: white;
  padding: 55px 6% 70px;
}

.hero h1 {
  font-size: 42px;
  margin: 0 0 12px;
}

.hero p {
  font-size: 17px;
  line-height: 1.6;
  opacity: 0.9;
  margin-bottom: 28px;
}

.search {
  max-width: 1000px;
  background: white;
  padding: 10px;
  border-radius: 12px;
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  box-shadow: 0 12px 30px #0003;
}

.search input,
.search select {
  flex: 1;
  min-width: 180px;
  border: 1px solid #e0e7ee;
  border-radius: 9px;
  outline: none;
  padding: 15px;
  font-size: 16px;
  color: #172033;
  background: white;
}

.search input:focus,
.search select:focus {
  border-color: #176b87;
  box-shadow: 0 0 0 3px #176b871c;
}

.search button {
  border: 0;
  border-radius: 9px;
  background: #0d7c66;
  color: white;
  padding: 15px 24px;
  font-weight: 700;
  font-size: 15px;
  cursor: pointer;
  transition: background 0.2s;
}

.search button:hover {
  background: #096650;
}

.search button:disabled {
  opacity: 0.65;
  cursor: wait;
}

.container {
  max-width: 1200px;
  margin: -35px auto 50px;
  padding: 0 20px;
  position: relative;
}

.card {
  background: white;
  border-radius: 14px;
  box-shadow: 0 5px 22px #18324d12;
  padding: 24px;
  margin-bottom: 20px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
}

.stat {
  background: #f7fafc;
  border: 1px solid #e5ebf1;
  border-radius: 10px;
  padding: 16px;
  overflow-wrap: anywhere;
}

.label {
  font-size: 12px;
  color: #68778a;
  text-transform: uppercase;
  font-weight: 700;
}

.value {
  font-size: 16px;
  font-weight: 700;
  margin-top: 7px;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.info {
  color: #245779;
  background: #eef8ff;
  border: 1px solid #cce8fa;
  padding: 15px;
  border-radius: 10px;
  margin-bottom: 20px;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.error {
  color: #a52d2d;
  background: #fff0f0;
  border: 1px solid #ffd0d0;
  padding: 15px;
  border-radius: 10px;
  margin-bottom: 20px;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.hidden {
  display: none !important;
}

.carrier-list {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
  margin-top: 18px;
}

.carrier-link {
  display: block;
  background: #f7fafc;
  border: 1px solid #e5ebf1;
  border-radius: 10px;
  padding: 15px;
  text-decoration: none;
  color: #174563;
  font-weight: 700;
  transition: background 0.2s, border-color 0.2s;
  overflow-wrap: anywhere;
}

.carrier-link:hover {
  background: #eaf4f8;
  border-color: #b8d6e5;
}

.carrier-link:focus-visible {
  outline: 3px solid #176b87;
  outline-offset: 2px;
}

.carrier-link small {
  display: block;
  margin-top: 6px;
  color: #68778a;
  font-weight: 400;
  line-height: 1.5;
}

.footer {
  text-align: center;
  color: #758396;
  font-size: 13px;
  padding: 20px;
}

@media (max-width: 800px) {
  .hero h1 {
    font-size: 31px;
  }

  .search {
    flex-direction: column;
  }

  .search input,
  .search select,
  .search button {
    width: 100%;
    min-height: 50px;
  }

  .grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .carrier-list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 460px) {
  .grid,
  .carrier-list {
    grid-template-columns: 1fr;
  }

  .hero {
    padding-top: 38px;
  }

  .card {
    padding: 18px;
  }

  .logo {
    font-size: 18px;
  }

  .badge {
    font-size: 11px;
  }
}
